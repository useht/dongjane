{
  "name": "dongjane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dongjane/server --filter @dongjane/client dev",
    "build": "pnpm --filter @dongjane/client build",
    "start": "pnpm --filter @dongjane/server start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "icons": "pnpm --filter @dongjane/client icons"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
